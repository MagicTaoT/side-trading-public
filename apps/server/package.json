{
  "name": "@side/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --watch --import tsx src/main.ts",
    "start": "node dist/src/main.js",
    "smoke": "node --import tsx src/smoke.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@side/market-core": "workspace:*",
    "@side/recorder-replay": "workspace:*",
    "@side/signal-engine": "workspace:*",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0"
  }
}
