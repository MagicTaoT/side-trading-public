# Copy to /etc/side/side.env on the EC2 host and chmod 600.
# Pass it to Compose with: --env-file /etc/side/side.env

# Host integration. 8088 stays private to the host; the existing HTTPS proxy
# for the existing service should route the SIDE hostname to http://127.0.0.1:8088.
SIDE_HTTP_BIND=127.0.0.1:8088
SIDE_DATA_ROOT=/srv/side/data
SIDE_POSTGRES_ROOT=/srv/side/postgres
SIDE_ENV_FILE=/etc/side/side.env
SIDE_IMAGE_TAG=local
SIDE_NODE_MAX_OLD_SPACE_MB=1024
# Ubuntu's first login user is normally 1000:1000. Confirm with `id`.
SIDE_RUNTIME_UID=1000
SIDE_RUNTIME_GID=1000

POSTGRES_DB=side
POSTGRES_USER=side
# Generate with: openssl rand -hex 32
SIDE_DB_PASSWORD=replace-with-64-hex-characters

# Generate with: openssl rand -hex 32
SIDE_ADMIN_PASSCODE=replace-with-64-hex-characters

# Required LIVE source credentials. Do not quote and do not commit this file.
BITQUERY_TOKEN=replace-me
ZEROEX_API_KEY=replace-me

# Optional explicit Jupiter fallback credential.
# JUPITER_API_KEY=replace-me

# Optional only after target-region preflight freezes a known product.
# Otherwise SIDE discovers the current Coinbase SLP product at startup.
# S0_COINBASE_PERP_PRODUCT=SLP-...

# Required full-site access gate (username: side), separate from admin controls.
# Generate interactively: docker run --rm -it caddy:2.11.4-alpine caddy hash-password
# Use single quotes in this Compose env file to preserve the bcrypt dollar signs.
SIDE_ACCESS_PASSWORD_HASH='replace-with-bcrypt-hash'
