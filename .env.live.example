# Copy to .env.live.local. Credentials remain in .env.preflight.local.
S0_RUNTIME_MODE=LIVE
DATABASE_URL=postgresql://side:side@127.0.0.1:5432/side
# Optional historical recorder overrides. Defaults to data/recordings and an auto-generated dataset ID.
# SIDE_RECORDING_DIR=data/recordings
# SIDE_RECORDING_DATASET_ID=live-local-test
# Optional backtest experiment/result history. Defaults to data/backtests.
# SIDE_BACKTEST_DIR=data/backtests
# Optional override. When absent, the current public Coinbase SLP product is discovered at startup.
# S0_COINBASE_PERP_PRODUCT=SLP-20DEC30-CDE
